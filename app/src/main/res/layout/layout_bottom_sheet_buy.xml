<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Ảnh, Thông tin, Nút X -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/imgProductSheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_shopping_cart" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/cardImage"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/cardImage"
            android:layout_toStartOf="@id/btnCloseSheet"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNameSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tên sản phẩm"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPriceSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="104.000đ"
                android:textColor="@color/shopee_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStockSheet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kho: 100"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:padding="4dp"
            android:src="@drawable/ic_add"
            android:rotation="45"
            app:tint="@color/text_gray" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#EEEEEE" />

    <!-- Số lượng -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Số lượng"
            android:textColor="@color/text_black"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_dialog_white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnMinusSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#F5F5F5"
                android:gravity="center"
                android:text="-"
                android:textColor="@color/text_black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvQuantitySheet"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnPlusSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#F5F5F5"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/text_black"
                android:textSize="18sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Nút Mua ngay -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmBuySheet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/shopee_primary"
        android:text="Mua ngay"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="4dp" />

</LinearLayout>
