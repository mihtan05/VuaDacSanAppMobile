<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:layout_centerVertical="true"
            android:contentDescription="Quay lại" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QUẢN LÝ LỊCH LÀM VIỆC"
            android:textColor="#EE4D2D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:layout_margin="10dp"
        android:padding="8dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edtTimKiem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tìm kiếm theo Mã NV, Ngày làm..."
            android:background="@null"
            android:padding="8dp"
            android:textSize="14sp"
            android:inputType="text"/>

        <ImageView
            android:id="@+id/btnTimKiem"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:layout_marginEnd="8dp"
            android:contentDescription="Icon tìm kiếm" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvLichLam"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#E0E0E0"
            android:dividerHeight="8dp"
            android:padding="8dp"
            android:clipToPadding="false"/>

        <TextView
            android:id="@+id/tvKhongCoDuLieu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có lịch làm việc nào"
            android:textColor="#666666"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_margin="10dp">

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XUẤT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#9E9E9E"
            android:layout_marginEnd="2dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnBatchInsert"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ĐK NHANH"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2196F3"
            android:layout_marginHorizontal="2dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnThemLich"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="THÊM MỚI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#EE4D2D"
            android:layout_marginStart="2dp"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
