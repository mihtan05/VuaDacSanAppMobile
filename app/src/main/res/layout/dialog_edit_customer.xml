<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_white"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="CẬP NHẬT KHÁCH HÀNG"
        android:textColor="#EE4D2D"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mã KH (read-only) -->
            <EditText
                android:id="@+id/edtEditMaKH"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Mã khách hàng"
                android:textSize="15sp"
                android:enabled="false"
                android:alpha="0.6" />

            <!-- Họ tên -->
            <EditText
                android:id="@+id/edtEditHoTen"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="Họ và tên (*)"
                android:textSize="15sp"
                android:inputType="textPersonName|textCapWords" />

            <!-- Số điện thoại -->
            <EditText
                android:id="@+id/edtEditSdt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="Số điện thoại (*)"
                android:inputType="phone"
                android:textSize="15sp" />

            <!-- Email -->
            <EditText
                android:id="@+id/edtEditEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="Email (*)"
                android:inputType="textEmailAddress"
                android:textSize="15sp" />

            <!-- Địa chỉ -->
            <EditText
                android:id="@+id/edtEditDiaChi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="Địa chỉ"
                android:textSize="15sp" />

            <!-- Tên đăng nhập -->
            <EditText
                android:id="@+id/edtEditDangnhap"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:hint="Tên đăng nhập (tuỳ chọn)"
                android:textSize="15sp"
                android:inputType="textNoSuggestions"
                android:fontFamily="monospace" />

            <!-- Trạng thái -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Trạng thái:"
                android:textColor="#333333"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCustTrangThai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCustHoat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoạt động" />

                <RadioButton
                    android:id="@+id/rbCustNgung"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="Ngừng hoạt động" />
            </RadioGroup>

            <!-- Nút Hủy / Cập nhật -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEditHuy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:backgroundTint="#BDBDBD"
                    android:text="HỦY"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnEditCapNhat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#EE4D2D"
                    android:text="CẬP NHẬT"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>