<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvIdLich"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="ID: 1"
            android:textColor="#EE4D2D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNgayLamViec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="15/04/2026"
            android:textColor="#000000"
            android:textStyle="italic"
            android:textSize="14sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvMaNhanVien"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhân viên: NV005"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCaLam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ca: Sáng"
            android:textColor="#333333"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNhiemVu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhiệm vụ: Sắp xếp kho hàng và kiểm kê đồ uống."
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

</LinearLayout>